    nullif(trim(payload->>'product_brand'), '') as brand,
    nullif(trim(payload->>'store_name'), '') as store_name,
    nullif(trim(payload->>'store_city'), '') as store_city,
    nullif(trim(payload->>'store_country'), '') as store_country
